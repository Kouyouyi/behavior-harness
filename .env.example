# Example paths only; no secrets. Source explicitly in your shell.
export SEEKACT_AGENT_PYTHON=/path/to/agent-python
export SEEKACT_SIM_PYTHON=/path/to/behavior-python
export SEEKACT_SIM_ROOT=/path/to/behavior-ap
export BEHAVIOR_ASSET_ROOT=/path/to/BEHAVIOR-1K
export SEEKACT_GPU_LOCK=/tmp/seekact-gpu.lock
# Optional: assets needing a controlled privilege helper. Unset for normal user access.
# export SEEKACT_SUDO_HELPER=/path/to/controlled-helper.sh
# Optional exact ToDesk display coexistence; every other compute process still blocks.
# export BEHAVIOR_ALLOW_TODESK_DISPLAY=1
# Store Qwen key in ~/.config/seekact/qwen_key, mode600, outside this repository.
